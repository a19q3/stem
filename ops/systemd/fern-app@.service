[Unit]
Description=Fern application at %f
PartOf=fern@%i.target
Upholds=fern-comet@%i.service
StartLimitIntervalSec=60s
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=%f/node.env
ExecStart=/usr/bin/env ${FERN_BINARY} run --home ${APP_HOME} --genesis ${FERN_GENESIS} --workers ${VM_WORKERS} --history-window ${HISTORY_WINDOW} --snapshot-interval ${SNAPSHOT_INTERVAL} $ADMISSION_ARGS $ROLE_ARGS
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2s
TimeoutStartSec=5min
TimeoutStopSec=30s
