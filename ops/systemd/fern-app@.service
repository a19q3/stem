[Unit]
Description=Fern application at %f
PartOf=fern@%i.target
Upholds=fern-comet@%i.service
StartLimitIntervalSec=60s
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=%f/node.env
ExecStart=/usr/bin/env ${FERN_BINARY} run --home ${APP_HOME} --genesis ${APP_STATE} --workers ${VM_WORKERS} --retain-consensus-blocks ${RETAIN_CONSENSUS_BLOCKS} $ADMISSION_ARGS $RPC_INDEX_ARGS $TRANSACTION_HISTORY_ARGS
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2s
TimeoutStartSec=5min
TimeoutStopSec=30s
