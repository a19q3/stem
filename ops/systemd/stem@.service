[Unit]
Description=Stem Jolteon replica at %f
After=network.target
StartLimitIntervalSec=60s
StartLimitBurst=6

[Service]
Type=exec
EnvironmentFile=%f/node.env
ExecStart=/usr/bin/env ${STEM_BINARY} run --home ${APP_HOME} --genesis ${STEM_GENESIS} --configuration ${STEM_CONFIGURATION} --key-file ${STEM_KEY} --history-window ${HISTORY_WINDOW} $ROLE_ARGS
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
