+    pub(super) fn transactions(&self, parent_height: u64) -> impl Iterator<Item = &Transaction> {
+        // Rotate the start of the existing ordered index. Reversing the low
+        // eight height bits spreads consecutive starts over the hash space.
+        let mut start = [0; 32];
+        start[0] = (parent_height as u8).reverse_bits();
+        self.entries
+            .range(start..)
+            .chain(self.entries.range(..start))
+            .map(|(_, entry)| &entry.tx)
     }

