@@ -0,0 +1,101 @@
+use super::*;
+use std::path::Path;
+
+#[allow(dead_code)]
+#[path = "../../contracts/test_support.rs"]
+mod contract;
+
+fn context(height: u64, count: usize, increment: u64, value: u128) -> ContextData {
+    ContextData {
+        height,
+        parent_time_ms: height * 1000,
+        payer_lock: [11; 32].pack(),
+        actors: vec![[7; 32].pack()],
+        payload: Bytes::copy_from_slice(&increment.to_le_bytes()),
+        inputs: (0..count)
+            .map(|index| Input {
+                id: [index as u8 + 1; 32].pack(),
+                version: height + index as u64,
+                capacity: 100_000_000_000 + index as u64,
+                data: Bytes::copy_from_slice(&value.to_le_bytes()),
+            })
+            .collect(),
+    }
+}
+
+#[test]
+fn runner_preserves_guest_outputs_and_exact_cycle_cutoffs() -> Result<()> {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("..");
+    let code = contract::native_contract(&root, "stem-lineage-counter")?;
+    const ISA: u8 = ISA_IMC | ISA_B | ISA_MOP;
+    let unpack = |run: Result<(Vec<Output>, u64)>| {
+        run.map(|(outputs, cycles)| {
+            (
+                outputs
+                    .into_iter()
+                    .map(|out| (out.capacity, out.data))
+                    .collect::<Vec<_>>(),
+                cycles,
+            )
+        })
+        .map_err(|e| e.to_string())
+    };
+    for active in [false, true] {
+        for (height, heads, increment, value) in [
+            (1, 1, 1, 0),
+            (5, 4, 7, 91),
+            (3, 2, 1, u128::MAX),
+            (8, 1, 0, 4),
+            (2, 8, 2, 71),
+            (1, 1, 1, 0),
+        ] {
+            let make = || context(height, heads, increment, value);
+            let interpreter = |limit| {
+                unpack(execute::<Interpreter>(
+                    &code,
+                    make(),
+                    <<Interpreter as DefaultMachineRunner>::Inner as SupportMachine>::new(
+                        ISA, VERSION2, limit,
+                    ),
+                    active,
+                ))
+            };
+            let expected = interpreter(20_000_000);
+            let mut budgets = vec![0, 300, 20_000_000];
+            if let Ok((output, cycles)) = &expected {
+                assert_eq!(output.len(), heads);
+                for (index, (capacity, data)) in output.iter().enumerate() {
+                    assert_eq!(*capacity, 100_000_000_000 + index as u64);
+                    assert_eq!(data.as_ref(), (value + u128::from(increment)).to_le_bytes());
+                }
+                budgets.extend([cycles - 1, *cycles, cycles + 1]);
+            } else {
+                assert!(increment == 0 || value == u128::MAX);
+            }
+            for limit in budgets {
+                let reference = interpreter(limit);
+                assert_eq!(
+                    unpack(execute::<ckb_script::types::Machine>(
+                        &code,
+                        make(),
+                        <<ckb_script::types::Machine as DefaultMachineRunner>::Inner as SupportMachine>::new(
+                            ISA, VERSION2, limit
+                        ),
+                        active
+                    )),
+                    reference
+                );
+                assert_eq!(
+                    unpack(execute::<ckb_script::runtime::Machine>(
+                        &code,
+                        make(),
+                        ckb_script::runtime::standalone_core(ISA, VERSION2, limit),
+                        active
+                    )),
+                    reference
+                );
+            }
+        }
+    }
+    Ok(())
+}
