+/// Allocate a standalone VM core with the same fresh-state semantics as the scheduler.
+pub fn standalone_core(
+    isa: u8,
+    version: u32,
+    max_cycles: u64,
+) -> <Machine as DefaultMachineRunner>::Inner {
+    #[cfg(all(has_asm, feature = "vm-reuse"))]
+    {
+        crate::reusable_asm::allocate_core(isa, version, max_cycles)
+    }
+    #[cfg(not(all(has_asm, feature = "vm-reuse")))]
+    {
+        ckb_vm::SupportMachine::new(isa, version, max_cycles)
+    }
+}
